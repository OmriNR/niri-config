/* Wallpaper picker grid, matching the niri waybar colors. */
configuration {
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    base:     #1e1e2eee;
    surface:  #313244;
    overlay:  #45475a;
    text:     #cdd6f4;
    subtext:  #6c7086;
    blue:     #89b4fa;
    mauve:    #cba6f7;
    font: "CaskaydiaCove Nerd Font SemiBold 11";
    background-color: transparent;
    text-color: @text;
}

window {
    width: 1040px;
    background-color: @base;
    border: 2px;
    border-color: @mauve;
    border-radius: 16px;
    padding: 20px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @surface;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
}

prompt { text-color: @mauve; }
entry  { placeholder: "Search wallpapers"; placeholder-color: @subtext; }

listview {
    columns: 4;
    lines: 2;
    spacing: 14px;
    fixed-columns: true;
    flow: horizontal;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 8px;
    spacing: 6px;
    border-radius: 12px;
    background-color: @surface;
    border: 2px;
    border-color: transparent;
}

element selected.normal {
    background-color: @overlay;
    border-color: @blue;
}

element-icon {
    size: 220px;
    horizontal-align: 0.5;
    border-radius: 8px;
}

element-text {
    horizontal-align: 0.5;
    text-color: inherit;
    font: "CaskaydiaCove Nerd Font 9";
}

element selected.normal element-text { text-color: @blue; }
